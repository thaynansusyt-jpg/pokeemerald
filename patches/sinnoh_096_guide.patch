+static const struct SpritePalette sSiGuidePalette = {sSiGuidePal, SI_GUIDE_PAL_TAG};
+static const struct OamData sSiGuideOam = {
+    .shape = SPRITE_SHAPE(16x16), .size = SPRITE_SIZE(16x16),
+    .priority = 0, .affineMode = ST_OAM_AFFINE_OFF, .bpp = ST_OAM_4BPP
+};
+static void SiGuideSpriteCB(struct Sprite *sprite);
+static const struct SpriteTemplate sSiGuideTemplate = {
+    .tileTag = SI_GUIDE_TILE_TAG, .paletteTag = SI_GUIDE_PAL_TAG,
+    .oam = &sSiGuideOam, .anims = gDummySpriteAnimTable,
+    .images = NULL, .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SiGuideSpriteCB
+};
+struct SiGuideGoal {u16 stage, map; s16 x,y;};
+static const struct SiGuideGoal sSiGuideGoals[] = {
+    {1, MAP_SANDGEM_LAB, 6, 3},       // Speak to Rowan
+    {2, MAP_ROUTE201, 0, 14},         // Route 201 western junction
+    {2, MAP_VERITY_LAKEFRONT, 2, 4},  // Enter lake
+    {2, MAP_LAKE_VERITY, 19, 41},     // Galactic collector (exact NPC)
+    {3, MAP_JUBILIFE_CITY_POKEMON_SCHOOL, 4, 3},
+    {4, MAP_OREBURGH_MUSEUM, 6, 3},
+    {5, MAP_OREBURGH_MINE_B2F, 18, 24},
+    {6, MAP_OREBURGH_CITY_GYM, 5, 2}
+};
+static u8 sSiGuideSpriteId = MAX_SPRITES;
+static u16 sSiGuideChime = 0;
+
+static const struct SiGuideGoal *SiGuideCurrentGoal(void)
+{
+    u16 i, map = gSaveBlock1Ptr->location.mapNum | (gSaveBlock1Ptr->location.mapGroup << 8);
+    u16 stage = VarGet(VAR_SI_STAGE);
+    for (i = 0; i < ARRAY_COUNT(sSiGuideGoals); i++)
+        if (sSiGuideGoals[i].stage == stage && sSiGuideGoals[i].map == map)
+            return &sSiGuideGoals[i];
+    return NULL; // Never point at an invented or inaccessible destination.
+}
+static void SiGuideSpriteCB(struct Sprite *sprite)
+{
+    const struct SiGuideGoal *goal = SiGuideCurrentGoal();
+    s16 playerX, playerY, drawX, drawY, dx, dy;
+    u8 id, frame = 0;
+    if (!SiIsSeason() || VarGet(VAR_SI_GUIDE_MODE) != 1 || !goal)
+    {
+        sprite->invisible = TRUE;
+        sSiGuideChime = 0;
+        return;
+    }
+    id = GetPlayerAvatarSpriteId();
+    if (id >= MAX_SPRITES || !gSprites[id].inUse)
+    {
+        sprite->invisible = TRUE;
+        return;
+    }
+    PlayerGetDestCoords(&playerX, &playerY);
+    dx = goal->x + MAP_OFFSET - playerX;
+    dy = goal->y + MAP_OFFSET - playerY;
+    drawX = gSprites[id].x + dx * 16;
+    drawY = gSprites[id].y + dy * 16 - 17;
+    // When out of view show a directional edge marker instead of a false NPC.
+    if (drawX < 14) {drawX = 14; frame = 2;}
+    else if (drawX > 226) {drawX = 226; frame = 3;}
+    if (drawY < 13) {drawY = 13; if (frame == 0) frame = 0;}
+    else if (drawY > 143) {drawY = 143; if (frame == 0) frame = 1;}
+    sprite->x = drawX;
+    sprite->y = drawY - ((sprite->data[0] / 10) % 3);
+    sprite->oam.tileNum = GetSpriteTileStartByTag(SI_GUIDE_TILE_TAG) + frame * 4;
+    sprite->data[0]++;
+    sprite->invisible = ((sprite->data[0] / 16) & 1) != 0;
+    // Short confirmation once at a mission target, not a repeated nuisance.
+    if (abs(dx) <= 1 && abs(dy) <= 1)
+    {
+        if (!sSiGuideChime) {PlaySE(SE_SELECT); sSiGuideChime = 1;}
+    }
+    else if (abs(dx) > 3 || abs(dy) > 3) sSiGuideChime = 0;
+}
+void SiGuideUpdate(void)
+{
+    u8 id;
+    if (!SiIsSeason() || VarGet(VAR_SI_GUIDE_MODE) != 1 || !SiGuideCurrentGoal())
+    {
+        if (sSiGuideSpriteId < MAX_SPRITES
+         && gSprites[sSiGuideSpriteId].inUse
+         && gSprites[sSiGuideSpriteId].callback == SiGuideSpriteCB)
+            gSprites[sSiGuideSpriteId].invisible = TRUE;
+        return;
+    }
+    if (sSiGuideSpriteId < MAX_SPRITES
+     && gSprites[sSiGuideSpriteId].inUse
+     && gSprites[sSiGuideSpriteId].callback == SiGuideSpriteCB)
+        return;
+    if (GetSpriteTileStartByTag(SI_GUIDE_TILE_TAG) == 0xFFFF)
+        LoadSpriteSheet(&sSiGuideSheet);
+    if (IndexOfSpritePaletteTag(SI_GUIDE_PAL_TAG) == 0xFF)
+        LoadSpritePalette(&sSiGuidePalette);
+    id = CreateSprite(&sSiGuideTemplate, 120, 70, 0);
+    if (id < MAX_SPRITES) {sSiGuideSpriteId = id; sSiGuideChime = 0;}
+}
