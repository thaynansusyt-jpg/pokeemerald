     }
     VarSet(VAR_SI_STARTER,1);
 }
+
+// The chapter resumes a script after a trainer battle. Only a genuine victory
+// advances its mandatory lake stage; a defeat allows the same encounter again.
+#include "battle.h"
+void SiLakeBattleWon(void)
+{
+    gSpecialVar_Result = (gBattleOutcome == B_OUTCOME_WON);
+}
