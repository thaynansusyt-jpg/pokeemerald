diff --git a/src/overworld.c b/src/overworld.c
index f77f5ca..4773def 100644
--- a/src/overworld.c
+++ b/src/overworld.c
@@ -745,6 +745,11 @@ void SetWarpDestinationToHealLocation(u8 healLocationId)
 
 static bool32 IsWhiteoutCutscene(void)
 {
+    // Sinnoh uses custom center maps and healing NPC scripts: the inherited
+    // rush-to-nurse whiteout cutscene can leave the script context locked.
+    // Use a regular field fade instead, while preserving the player's heal warp.
+    if (SiIsSeason())
+        return FALSE;
     if (OW_WHITEOUT_CUTSCENE < GEN_4)
         return FALSE;
     return GetHealNpcLocalId(GetHealLocationIndexByWarpData(&gSaveBlock1Ptr->lastHealLocation)) != LOCALID_NONE;
diff --git a/src/sinnoh_chapter.c b/src/sinnoh_chapter.c
