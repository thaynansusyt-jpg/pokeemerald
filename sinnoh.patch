+#include "item.h"
+#include "pokemon.h"
+#include "constants/items.h"
+void SiCoachFillCandy(void)
+{
+    u32 count;
+    gSpecialVar_Result = FALSE;
+    if (!SiIsSeason() || !FlagGet(FLAG_HE_ANTI_GRINDING)) return;
+    count = CountTotalItemQuantityInBag(ITEM_RARE_CANDY);
+    gSpecialVar_Result = count >= 999 || AddBagItem(ITEM_RARE_CANDY, 999 - count);
+}
+void SiCoachMaxIvs(void)
+{
+    u32 i, j;
+    u8 value = 31;
+    if (!SiIsSeason() || !FlagGet(FLAG_HE_ANTI_GRINDING)) return;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (!GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) || GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)) continue;
+        for (j = 0; j < 6; j++) SetMonData(&gPlayerParty[i], MON_DATA_HP_IV + j, &value);
+        CalculateMonStats(&gPlayerParty[i]);
+    }
+}
+
+static bool8 SiHasPartner(u16 species)
+{
+    u32 i;
+    for(i=0;i<PARTY_SIZE;i++)
+        if(GetMonData(&gPlayerParty[i],MON_DATA_SPECIES)==species&&!GetMonData(&gPlayerParty[i],MON_DATA_IS_EGG))
+            return TRUE;
+    return FALSE;
+}
+void SiCheckBudew(void) {gSpecialVar_Result=SiHasPartner(SPECIES_BUDEW);}
+void SiCheckStarly(void) {gSpecialVar_Result=SiHasPartner(SPECIES_STARLY);}
+void SiInferStarter(void)
+{
+    u32 i,species;
+    if(VarGet(VAR_SI_STARTER)>=1&&VarGet(VAR_SI_STARTER)<=3)return;
+    for(i=0;i<PARTY_SIZE;i++)
+    {
+        species=GetMonData(&gPlayerParty[i],MON_DATA_SPECIES);
+        if(species==SPECIES_TURTWIG||species==SPECIES_GROTLE||species==SPECIES_TORTERRA){VarSet(VAR_SI_STARTER,1);return;}
+        if(species==SPECIES_CHIMCHAR||species==SPECIES_MONFERNO||species==SPECIES_INFERNAPE){VarSet(VAR_SI_STARTER,2);return;}
+        if(species==SPECIES_PIPLUP||species==SPECIES_PRINPLUP||species==SPECIES_EMPOLEON){VarSet(VAR_SI_STARTER,3);return;}
+    }
+    VarSet(VAR_SI_STARTER,1);
+}
