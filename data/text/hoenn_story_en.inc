@ Generated by tools/localization/generate_story.py. Edit the catalog instead.
HE_English_0::
	.string "I'm the training coach. Take these\ncandies to train without repeating the\psame route. Come back when you have\nfewer than ten.\pThe hard level cap also applies to\ncandies.$"

	.global HE_CoachGift
HE_English_1::
	.string "You already have training candies. Use\nthem before asking for more.\pTraining helps you catch up in levels.\nStrategy still decides the battle.$"

	.global HE_CoachEnough
HE_English_2::
	.string "Assisted training is disabled under\nthis journey's rules. Every adventure\pcan have its own challenge!$"

	.global HE_CoachOff
HE_English_3::
	.string "There is no room for the candies. Make\nsome space in your Bag and come back\pfor your training supplies.$"

	.global HE_CoachBagFullText
HE_English_4::
	.string "Rocket's inventory included records\nfrom other regions.\pChoose a region of origin. We'll look for\neach survivor without using their\pmachines.$"

	.global HE_QuestBoardIntro
HE_English_5::
	.string "Target: {STR_VAR_1}.\pArea: {STR_VAR_2}.\pSample: {STR_VAR_3}.\pTalk to our researcher at the Pokémon\nCenter assigned to that region of\porigin.$"

	.global HE_QuestTarget
HE_English_6::
	.string "Accept this investigation? It will\nreplace your active mission.\pCompleted captures will remain on\nrecord.$"

	.global HE_QuestReplace
HE_English_7::
	.string "Mission registered!\pKanto: Rustboro. Johto: Dewford.\pHoenn: Slateport. Sinnoh: Mauville.\pUnova: Lavaridge. Kalos: Fortree.\pAlola: Mossdeep.\pTake the sample to the researcher at\nthe assigned Pokémon Center.$"

	.global HE_QuestAccepted
HE_English_8::
	.string "No investigation is active. Choose a\ntarget at the board.$"

	.global HE_QuestNoActive
HE_English_9::
	.string "We need to reopen the League before\nlaunching expeditions. Come back after\pyou become Champion.$"

	.global HE_QuestEarlyText
HE_English_10::
	.string "Every target from this region has been\nrecorded! Choose another region at the\pboard.$"

	.global HE_QuestFinishedRegion
HE_English_11::
	.string "I compare network signals with traces\nfound in nature.\pAfter the League, choose an\ninvestigation at Professor Birch's\plaboratory.$"

	.global HE_QuestResearchIntro
HE_English_12::
	.string "I'm investigating {STR_VAR_1}.\pI need to analyze a sample:\n{STR_VAR_3}.\pI won't use it up. Come back when you\nhave it in your Bag.$"

	.global HE_QuestNeedEvidence
HE_English_13::
	.string "The pattern matches\n{STR_VAR_1}!\pThe expedition at\n{STR_VAR_2} is now\pauthorized.\pTalk to the field researcher near the\nentrance.$"

	.global HE_QuestResearchReady
HE_English_14::
	.string "The signal from {STR_VAR_1} only\nappears at night.\pThe expedition at\n{STR_VAR_2} is now\pauthorized.\pVisit the habitat between 6 p.m. and 6\na.m. We use the RTC.$"

	.global HE_QuestResearchNight
HE_English_15::
	.string "This station tracks Pokémon that\nRocket forcibly transported.\pAccept an investigation at Professor\nBirch's lab.$"

	.global HE_QuestBeaconIntro
HE_English_16::
	.string "The target is in this area, but the\nsample still needs to be analyzed at\pthe Pokémon Center.\pWe won't lure it out blindly.$"

	.global HE_QuestNeedResearch
HE_English_17::
	.string "The signal only appears at night. Come\nback between 6 p.m. and 6 a.m.\pThere is no need to change your bedroom\nclock. We use the RTC.$"

	.global HE_QuestNeedNight
HE_English_18::
	.string "The sensor found {STR_VAR_1}!\pIf you flee or defeat it, talk to me to\ntry again. Good luck!$"

	.global HE_QuestSignal
HE_English_19::
	.string "The signal is still active. Prepare your\nteam and talk to me when you want to\ptry again.$"

	.global HE_QuestRetry
HE_English_20::
	.string "Capture confirmed! Investigation\ncomplete.\pThe lab has received the data. Choose\nyour next target at the board.$"

	.global HE_QuestCapturedText
HE_English_21::
	.string "There is no room for the Mega Ring. Make\nsome space in your Bag and come back.\pThe rescue is still on record.$"

	.global HE_RainbowRingBagFullText
HE_English_22::
	.string "ENGINEER: Our rescue is complete, but\nyou don't have the Mega Ring.\pTake it with you on your journey.$"

	.global HE_RainbowRecoverRingText
HE_English_23::
	.string "BIRCH: First we need to reopen the\nLeague. Then we'll investigate the\precords Rocket left behind.$"

	.global HE_RainbowEarlyText
HE_English_24::
	.string "RADIO: Space Center calling Birch... The\nradar is stuck on the same second!\pA light split the clouds. There is a\nblack creature above Sky Pillar...\pThe transmission fades out.$"

	.global HE_RainbowDistress
HE_English_25::
	.string "BIRCH: Giovanni's command center was\nshut down, but someone activated an\pexternal copy.\pThe signal uses coordinates that don't\nexist in Hoenn.\pI won't send civilians to the tower\nwithout knowing the risk.\pFind our team at the entrance to Meteor\nFalls.\pIf there is another passage, we need to\nclose it from inside.$"

	.global HE_RainbowBriefing
HE_English_26::
	.string "BIRCH: Find our team at the entrance to\nMeteor Falls. The new signal starts\pthere.$"

	.global HE_RainbowMeteorHint
HE_English_27::
	.string "BIRCH: Vesper was seen at the Mossdeep\nSpace Center. The radar may locate the\psource of the transmission.$"

	.global HE_RainbowSpaceHint
HE_English_28::
	.string "BIRCH: Rescue the engineer in the\nfirst-floor rooms of the abandoned\pship.\pHe knows how the controller attached\nto Rayquaza works.$"

	.global HE_RainbowShipHint
HE_English_29::
	.string "BIRCH: The controller is off. Go to the\ntop of Sky Pillar and cut the\pconnection to the other world.$"

	.global HE_RainbowSkyHint
HE_English_30::
	.string "PRISMA: You defeated Rocket in this\nworld.\pRainbow Rocket chooses only worlds\nwhere we have already won.\pWhy do you think yours will stay free?\pMeteor Falls is the hinge of the door.\nYou won't get through!$"

	.global HE_RainbowScoutIntro
HE_English_31::
	.string "This reality... resists!$"

	.global HE_RainbowDefeat
HE_English_32::
	.string "The terminal shows Sky Pillar's orbit. A\ncontrol command originates at the\pMossdeep Space Center.\pBIRCH: This Giovanni isn't the man we\narrested.\pHe crossed over using our network as an\nanchor.$"

	.global HE_RainbowScoutAfter
HE_English_33::
	.string "VESPER: I gave my records to the\nLeague. He threatened to erase our\pHoenn if I didn't repair the network.\pI can let him through, or trust you\nagain.\pShow me you can still stop what I built.$"

	.global HE_RainbowVesperIntro
HE_English_34::
	.string "VESPER: Enough. I won't build another\nprison.\pThey took the engineer to the\nabandoned ship. He can free Rayquaza\pbefore the door opens.\pI'll keep the radar offline. Go get him.$"

	.global HE_RainbowVesperAfter
HE_English_35::
	.string "ENGINEER: Rainbow Rocket used a ring to\nforce that black Rayquaza to Mega\pEvolve.\pIt isn't anger. It tries to escape, and\nthe controller sends the pain back into\pthe region itself.$"

	.global HE_RainbowShipIntro
HE_English_36::
	.string "You and the engineer reverse the\ncurrent.\pThe control ring goes dark. In the\ndistance, the sea grows calm.\pENGINEER: Now it can choose. Take this\nMega Ring and free the tower.\pRayquaza needs Dragon Ascent to Mega\nEvolve.$"

	.global HE_RainbowShipAfter
HE_English_37::
	.string "GIOVANNI: In my world, the resistance is\ngone.\pIn this one, you taught an entire region\nto refuse me.\pA black Rayquaza opened the passage.\nIts Mega Evolution sustains my last\panchor.\pBreak this bond, and I lose my way home.\pI will not accept that defeat.$"

	.global HE_RainbowGiovanniIntro
HE_English_38::
	.string "The portal dissolves into ribbons of\nlight. Giovanni vanishes with Rainbow\pRocket's last soldiers.\pRayquaza lands, free at last. Its black\nscales reflect Hoenn's first lights.\pIt waits for your decision.$"

	.global HE_RainbowGiovanniAfter
HE_English_39::
	.string "The Shiny Rayquaza is free. Would you\nlike to try catching it?\pIf you fail, you can try again at this\nstation.$"

	.global HE_RainbowRayChoice
HE_English_40::
	.string "BIRCH: We didn't save Hoenn to choose\nits rulers. We saved it so everyone\pcould choose their own future.\pVESPER shut down the last bridge. The\nengineer returned to his family.\pRainbow Rocket has no anchor left.\pYour Rayquaza knows Dragon Ascent.\nWith the Mega Ring, it can Mega Evolve.\pThe sky belongs to those who live\nbeneath it again.$"

	.global HE_RainbowEnding
HE_English_41::
	.string "The anchors have been erased. Hoenn is\nfree from Rainbow Rocket.\pExpeditions continue at the\nprofessor's laboratory.$"

	.global HE_RainbowRestored
HE_English_42::
	.string "There is no active signal here yet.\nConsult Birch at the Littleroot\plaboratory to continue the\ninvestigation.$"

	.global HE_RainbowWaitText
HE_English_43::
	.string "I count the insects along this route.\nAfter the blackout, species I'd never\pseen here started appearing.\pLet's test my partners!$"

	.global HE_BugMiloIntro
HE_English_44::
	.string "I need to study these species!$"

	.global HE_BugMiloDefeat
HE_English_45::
	.string "Grubbin arrived on a Rocket convoy. I\nsheltered it until the route reopened.\pNow it has chosen to stay.$"

	.global HE_BugMiloAfter
HE_English_46::
	.string "The bugs returned before the guards.\nThey tell me whether the forest is safe.\pLet's battle!$"

	.global HE_BugLiaIntro
HE_English_47::
	.string "Your team never loses its way!$"

	.global HE_BugLiaDefeat
HE_English_48::
	.string "I've been helping researchers count\nthe survivors.\pWhen the League reopens, the forest\nwill become an expedition station.$"

	.global HE_BugLiaAfter
HE_English_49::
	.string "BIRCH wants to speak with you at the\nLittleroot laboratory.\pExpeditions also begin at the\nlaboratory's board.$"

	.global HE_PostJournalStartText
HE_English_50::
	.string "ORION: The League offers badges. I\noffer clean water. All I want is the\ppeople's Pokémon.\pThis meteorite powers the antenna. A\npretty name doesn't change who\pcontrols the tap.$"

	.global HE_Thermal_Intro
HE_English_51::
	.string "ORION fled, but left the thermal pulse\nactive.\pFLANNERY: The hospital needs the\nnetwork's backup power. Families need\ptransport.\pWhich gets help first?$"

	.global HE_Thermal_After
HE_English_52::
	.string "The thermal transmitter stopped. Local\nteams took over the shelters.\pFLANNERY: We don't choose who deserves\nhelp. Only who we can reach first.\pNow I can test your team.$"

	.global HE_Thermal_Done
HE_English_53::
	.string "DECODER\pRepeat the three pulses: B - C - A.\pB closes the panel without using any\nitems.$"

	.global HE_Thermal_Pattern
HE_English_54::
	.string "RADIO: Ash has reached the reservoirs!\pFLANNERY: The elderly can't get out. The\nthermal transmitter is in the square.\pI won't abandon the town for a battle.$"

	.global HE_ArrivalThermal_Text
HE_English_55::
	.string "The town needs our help before the\nchallenge.\pFind the transmitter and the\nresistance officer in Lavaridge.$"

	.global HE_NeedThermal_Text
HE_English_56::
	.string "ROCKET: These contracts are legal. Want\nto tear them all up?\pThen you'll have to answer for the food\nsupply.$"

	.global HE_Supply_Intro
HE_English_57::
	.string "You recovered the list of hostages.\pNORMAN: The convoy can carry medicine\nor evacuate the threatened families.\pI'll organize the second trip. You\nchoose the first.$"

	.global HE_Supply_After
HE_English_58::
	.string "The contracts were destroyed and the\nwarehouse reopened.\pNORMAN: Responsibility isn't obeying\nthe strongest. It's answering to those\pwho depend on you.\pI'm proud to see that in your journey.$"

	.global HE_Supply_Done
HE_English_59::
	.string "DECODER\pRepeat the three pulses: C - A - B.\pB closes the panel without using any\nitems.$"

	.global HE_Supply_Pattern
HE_English_60::
	.string "NORMAN: People have arrived from\nLavaridge. The food warehouse has\pbecome a prison.\pRocket registered families as debts.\nThey fear losing shelter if they refuse\pto hand over their Pokémon.$"

	.global HE_ArrivalSupply_Text
HE_English_61::
	.string "The city needs our help before the\nchallenge.\pFind the transmitter and the\nresistance officer in Petalburg.$"

	.global HE_NeedSupply_Text
HE_English_62::
	.string "VESPER: You cut antennas. I buy\nsilence. Tomorrow, they'll thank us for\pkeeping order.\pI can't let that technician speak. My\noperation depends on looking like a\prescue.$"

	.global HE_Forest_Intro
HE_English_63::
	.string "The testimony was broadcast. The\nshelters learned of the extortion.\pWINONA: Pokémon are trapped in the\nbranches, and the Institute needs\ppower.\pWe need both, but you decide the first\nshipment.$"

	.global HE_Forest_After
HE_English_64::
	.string "The pulses ceased. Flocks from many\nregions are returning to the forest.\pWINONA: We'll take the testimony to\nMossdeep.\pRocket's orbital system is the last\npiece.$"

	.global HE_Forest_Done
HE_English_65::
	.string "DECODER\pRepeat the three pulses: A - C - B.\pB closes the panel without using any\nitems.$"

	.global HE_Forest_Pattern
HE_English_66::
	.string "WINONA: This isn't a storm. The birds are\nfleeing the Institute's pulses.\pA technician deserted Rocket and\nbrought the frequencies.\pWe have a chance to free the migration\nroute.$"

	.global HE_ArrivalForest_Text
HE_English_67::
	.string "The city needs our help before the\nchallenge.\pFind the transmitter and the\nresistance officer in Fortree.$"

	.global HE_NeedForest_Text
HE_English_68::
	.string "ORION: After launch, no shelter gets\npower without my permission.\pThe crisis gave us soldiers. Your diary\nwon't stop a satellite.$"

	.global HE_Orbit_Intro
HE_English_69::
	.string "The launch codes were copied to the\nLeague.\pSTEVEN: The telescope also detected a\ndisturbance beneath the sea.\pWe can send aid to the islands or\nstabilize communications first.$"

	.global HE_Orbit_After
HE_English_70::
	.string "The orbital signal was isolated. The\nSpace Center can warn the islands.\pSTEVEN: Vesper took the last core to\nthe seabed.\pIf she awakens the ancient sources, no\nantenna can contain the disaster.$"

	.global HE_Orbit_Done
HE_English_71::
	.string "DECODER\pRepeat the three pulses: C - B - A.\pB closes the panel without using any\nitems.$"

	.global HE_Orbit_Pattern
HE_English_72::
	.string "STEVEN: The Space Center's emergency\ncodes were stolen.\pRocket plans to send a command across\nthe entire Devon network.\pA single pulse could shut down the\nwhole region.$"

	.global HE_ArrivalOrbit_Text
HE_English_73::
	.string "The city needs our help before the\nchallenge.\pFind the transmitter and the\nresistance officer in Mossdeep.$"

	.global HE_NeedOrbit_Text
HE_English_74::
	.string "VESPER: I wanted a dependent region,\nnot a dead one.\pOrion sent power beyond the limit. If I\nsurrender the core, Giovanni will\pabandon me here.\pDon't ask me to trust the League now.$"

	.global HE_Ocean_Intro
HE_English_75::
	.string "VESPER: The core accepts a sequence of\nthree pulses. Use the decoder.\pWALLACE: Evacuation continues through\nthe lake. Our technicians are restoring\pthe network.\pSet the final convoy's priority.$"

	.global HE_Ocean_After
HE_English_76::
	.string "The ocean core was shut down. Recovery\nstill depends on calming the legendary\pPokémon.\pVESPER: Giovanni already has a copy of\nthe codes. He's waiting at the League\pcommand center.\pTake my records. Don't let him start\nagain.$"

	.global HE_Ocean_Done
HE_English_77::
	.string "DECODER\pRepeat the three pulses: B - A - C.\pB closes the panel without using any\nitems.$"

	.global HE_Ocean_Pattern
HE_English_78::
	.string "WALLACE: The city has become a shelter\nfor those who lost the coast.\pVesper doesn't control the sea. She\nonly removed the restraints.\pWe need Rayquaza and the core shut\ndown. A battle alone won't solve this.$"

	.global HE_ArrivalOcean_Text
HE_English_79::
	.string "The city needs our help before the\nchallenge.\pFind the transmitter and the\nresistance officer in Sootopolis.$"

	.global HE_NeedOcean_Text
HE_English_80::
	.string "The first convoy rescued trapped\nfamilies and Pokémon.\pThe medical team left supplies for your\njourney. The second convoy will repair\pthe network.$"

	.global HE_RescueReport
HE_English_81::
	.string "The first convoy restored power to\nwater pumps and hospitals.\pThe technicians left supplies. The\nsecond convoy will evacuate the\pfamilies.$"

	.global HE_EnergyReport
HE_English_82::
	.string "The resistance now controls this\ntransmitter. Both convoys arrived.\pYour next battle is listed in the\nMISSION diary.$"

	.global HE_RelayDoneReport
HE_English_83::
	.string "We aren't authorized to work on this\nnetwork yet.\pCheck your current mission in the menu.\nThe Gym Leaders will prepare the next\poperation.$"

	.global HE_TooEarlyReport
HE_English_84::
	.string "The red boxes are transmitters seized\nby Rocket. Examine a box to begin the\poperation.\pThe decoder uses A, B and C. Mistakes or\nquitting won't use up items.\pChoosing Rescue prioritizes people and\nearns potions.\pPower prioritizes hospitals and earns\nethers. The second convoy completes\pthe other task.$"

	.global HE_LiaisonText
HE_English_85::
	.string "Pulse accepted. Repeat the next signal.$"

	.global HE_CampaignNextPulse
HE_English_86::
	.string "We can't hold the command center!$"

	.global HE_CampaignEnemyDefeat
HE_English_87::
	.string "GIOVANNI: Vesper gave up her records.\nOrion lost the orbit. And you brought\pthe people back to the League.\pBut the region is still broken. Who will\npay for reconstruction?\pI have a copy of the Devon codes. While\nthis center stands, every city depends\pon my signature.\pIf you want a future without Rocket,\nprove you can defend it.$"

	.global HE_GiovanniIntro
HE_English_88::
	.string "Their trust... wasn't for sale.$"

	.global HE_GiovanniDefeat
HE_English_89::
	.string "BIRCH, over the radio: The copy is\nerased. The League received the\pshelter records and freed the\nhostages.\pGIOVANNI: I cannot bargain with a\nregion that chose to stand up.\pThe commander was arrested. Vesper will\ntestify. Orion faces charges for the\pSpace Center attack.\pWALLACE: Come to the League. Your\nchallenge now is to earn a title in a\pfree Hoenn.$"

	.global HE_FinalCentralReport
HE_English_90::
	.string "WALLACE: Rocket still holds a copy of\nthe network in this city.\pShut down the red box near the officer\nbefore challenging the League. Giovanni\pis there.$"

	.global HE_FinalCentralNeeded
HE_English_91::
	.string "DAYS LATER...\pHospital lights came back on. Routes\nreopened. Pokémon returned to the\pforests.\pYou prioritized rescue in\n{STR_VAR_1} operations. The\presistance completed all remaining\nconvoys.\pBIRCH: The Pokédex doesn't just record\nspecies. It records those who found a\phome again.\pNORMAN: Hoenn still has wounds. The\ndifference is that nobody has to carry\pthem alone now.\pSENHOR LARANJA: Your journey isn't\nover, Champion. We have a region to\pexplore!\pOPERATION ECLIPSE COMPLETE. The\ncampaign is over. Keep catching\pPokémon and exploring Hoenn.$"

	.global HE_EpilogueText
HE_English_92::
	.string "RESISTANCE MISSION\pGet your starter and meet your rival on\nRoute 103.\pThen return to Birch's laboratory.$"

	.global HE_CampaignGoalText0
HE_English_93::
	.string "RESISTANCE MISSION\pFind the researcher in Petalburg Woods.\pRocket is after the Devon documents.$"

	.global HE_CampaignGoalText1
HE_English_94::
	.string "RESISTANCE MISSION\pTake the evidence to Rustboro and\nchallenge Roxanne.$"

	.global HE_CampaignGoalText2
HE_English_95::
	.string "RESISTANCE MISSION\pGet the decoder from the researcher in\nRustboro.\pShut down the first transmitter.$"

	.global HE_CampaignGoalText3
HE_English_96::
	.string "RESISTANCE MISSION\pTravel with Briney to Dewford and\ndisable the signal at Granite Cave's\pentrance.$"

	.global HE_CampaignGoalText4
HE_English_97::
	.string "RESISTANCE MISSION\pReturn to Rustboro and head for the\neast exit.\pDevon was robbed! Rescue Peeko and the\ncargo in Rusturf Tunnel, at the end of\pRoute 116.$"

	.global HE_CampaignGoalPeekoText
HE_English_98::
	.string "RESISTANCE MISSION\pReturn the cargo to the employee in\nRustboro.\pSpeak with Stone at Devon before\nlooking for Briney on Route 104.$"

	.global HE_CampaignGoalDevonText
HE_English_99::
	.string "RESISTANCE MISSION\pThe island is protected. Challenge\nBrawly.$"

	.global HE_CampaignGoalText5
HE_English_100::
	.string "RESISTANCE MISSION\pProtect Stern on the second floor of\nthe Slateport museum.$"

	.global HE_CampaignGoalText6
HE_English_101::
	.string "RESISTANCE MISSION\pStern gave you the key. Disable\nMauville's transmitter.$"

	.global HE_CampaignGoalText7
HE_English_102::
	.string "RESISTANCE MISSION\pMauville's network is safe. Challenge\nWattson.$"

	.global HE_CampaignGoalText8
HE_English_103::
	.string "RESISTANCE MISSION\pAsh and thirst: find the red box and the\nofficer in Lavaridge.$"

	.global HE_CampaignGoalText9
HE_English_104::
	.string "RESISTANCE MISSION\pThe town is protected. Challenge\nLavaridge's Gym Leader.$"

	.global HE_CampaignGoalText10
HE_English_105::
	.string "RESISTANCE MISSION\pThe price of shelter: find the red box\nand the officer in Petalburg.$"

	.global HE_CampaignGoalText11
HE_English_106::
	.string "RESISTANCE MISSION\pThe city is protected. Challenge\nPetalburg's Gym Leader.$"

	.global HE_CampaignGoalText12
HE_English_107::
	.string "RESISTANCE MISSION\pA forest without song: find the red box\nand the officer in Fortree.$"

	.global HE_CampaignGoalText13
HE_English_108::
	.string "RESISTANCE MISSION\pThe city is protected. Challenge\nFortree's Gym Leader.$"

	.global HE_CampaignGoalText14
HE_English_109::
	.string "RESISTANCE MISSION\pAn orbit of lies: find the red box and\nthe officer in Mossdeep.$"

	.global HE_CampaignGoalText15
HE_English_110::
	.string "RESISTANCE MISSION\pThe city is protected. Challenge\nMossdeep's Gym Leaders.$"

	.global HE_CampaignGoalText16
HE_English_111::
	.string "RESISTANCE MISSION\pThe sea won't obey: find the red box and\nthe officer in Sootopolis.$"

	.global HE_CampaignGoalText17
HE_English_112::
	.string "RESISTANCE MISSION\pThe city is protected. Challenge\nSootopolis's Gym Leader.$"

	.global HE_CampaignGoalText18
HE_English_113::
	.string "RESISTANCE MISSION\pEight badges unlock the final\noperation.\pFind the red box in Ever Grande and\nface Giovanni.$"

	.global HE_CampaignGoalText19
HE_English_114::
	.string "RESISTANCE MISSION\pRocket lost the network. Cross Victory\nRoad and conquer the Pokémon League.$"

	.global HE_CampaignGoalText20
HE_English_115::
	.string "Operation Eclipse is over. Hoenn is free\nfrom Rocket.\pContinue your research, catch species\nfrom other regions and visit your\pallies.$"

	.global HE_CampaignDoneText
HE_English_116::
	.string "RESISTANCE DIARY\pTransmitters shut down:\n{STR_VAR_1}/3.\pWatch the two pulses and repeat their\norder at the panel.\pB closes the decoder.$"

	.global HE_Text_Journal
HE_English_117::
	.string "Shut down the transmitter near\nRustboro's Gym.\pThen find Briney on Route 104.$"

	.global HE_Text_GoalRustboro
HE_English_118::
	.string "The island transmitter is at Granite\nCave's entrance, north of Dewford.$"

	.global HE_Text_GoalDewford
HE_English_119::
	.string "Challenge Brawly. Then Briney will take\nyou to Slateport's harbor.$"

	.global HE_Text_GoalBrawly
HE_English_120::
	.string "Help Stern on the second floor of\nSlateport's museum.\pRocket seized the harbor!$"

	.global HE_Text_GoalHarbor
HE_English_121::
	.string "Find the transmitter in Mauville's\nsquare.\pUse the key Stern gave you.$"

	.global HE_Text_GoalMauville
HE_English_122::
	.string "The network is safe. Challenge Wattson\nand earn your third badge.$"

	.global HE_Text_GoalWattson
HE_English_123::
	.string "Three cities protected!\pThe fight continues beyond Mauville.\nFind the resistance radio in each city.$"

	.global HE_Text_GoalEnd
HE_English_124::
	.string "RESEARCHER: I built a decoder using the\ndata from the forest.\pIt reads Rocket's network pulses.\pYou'll cut the signal, city by city.$"

	.global HE_Text_Decoder
HE_English_125::
	.string "Open MISSION in the menu to see your\nobjective.\pHere, repeat A and then C. Made a\nmistake? You can try again.\pNo items are used. B or Exit closes the\npanel.$"

	.global HE_Text_DecoderHow
HE_English_126::
	.string "Roxanne needs to assess your team\nbefore we hand over the decoder.$"

	.global HE_Text_Early
HE_English_127::
	.string "I'm a resistance volunteer. Would you\nlike me to take care of your Pokémon?$"

	.global HE_Text_Medic
HE_English_128::
	.string "All done! Your partners are healed.\pWe aren't alone in this crisis.$"

	.global HE_Text_Healed
HE_English_129::
	.string "Incorrect pulse. The terminal reset.\pWatch the pattern and try again.$"

	.global HE_Text_PuzzleWrong
HE_English_130::
	.string "Transmitter shut down. There is no\ncontrol signal left.$"

	.global HE_Text_PuzzleDone
HE_English_131::
	.string "An unknown signal pulses on the panel.\pFind the researcher near Rustboro's\nGym after earning your first badge.$"

	.global HE_Text_NoDecoder
HE_English_132::
	.string "First pulse accepted. Choose the\nsecond.$"

	.global HE_Text_NextPulse
HE_English_133::
	.string "DECODER\pPattern: A, then C.\pRepeat both pulses to cut the signal.$"

	.global HE_Text_PatternRustboro
HE_English_134::
	.string "The transmitter lost power!\pThe sea route is clear. Rescue Peeko\nand return the cargo to Devon in\pRustboro.\pThen find Briney at the house on Route\n104. Your diary shows the remaining\pstep.$"

	.global HE_Text_RelayRustboroOff
HE_English_135::
	.string "DECODER\pPattern: B, then A.\pRepeat both pulses to cut the signal.$"

	.global HE_Text_PatternDewford
HE_English_136::
	.string "The interference stopped. Boats can\nsail again!\pBrawly is waiting at the Gym. We\nprotected the island, but the harbor is\pstill in danger.$"

	.global HE_Text_RelayDewfordOff
HE_English_137::
	.string "DECODER\pPattern: C, then B.\pRepeat both pulses to cut the signal.$"

	.global HE_Text_PatternMauville
HE_English_138::
	.string "The city's lights are back on!\pGo to the Gym. Wattson will prepare the\nresistance for its next step.$"

	.global HE_Text_RelayMauvilleOff
HE_English_139::
	.string "ROCKET: This signal keeps the island\nisolated.\pNo boats, no help! Don't touch that\npanel.$"

	.global HE_Text_CaveGuard
HE_English_140::
	.string "The island will get help...$"

	.global HE_Text_CaveGuardLose
HE_English_141::
	.string "VESPER: You freed the harbor, but\nbrought the decoder straight to me.\pMauville's network is the key to the\noperation. I'll take that device!$"

	.global HE_Text_GeneratorVesper
HE_English_142::
	.string "The network rejected my command?!$"

	.global HE_Text_GeneratorLose
HE_English_143::
	.string "This terminal needs a key from the\nharbor.\pHelp Stern at Slateport's museum to get\nthe right frequency.$"

	.global HE_Text_NeedHarbor
HE_English_144::
	.string "The road is open, but avoid checkpoints\nbearing the R symbol.\pThe police radio is silent. If you find\nBirch, tell him.$"

	.global HeRebuild_Text_Officer
HE_English_145::
	.string "The fuel would have been used to erase\nevidence of the sabotage.$"

	.global MossdeepCity_SpaceCenter_2F_Text_WhyWouldMagmaStealRocketFuel
HE_English_146::
	.string "Rocket won't erase what we saw here.$"

	.global MossdeepCity_SpaceCenter_2F_Text_MagmaCantGetAwayWithThis
HE_English_147::
	.string "ROCKET: The technicians aren't leaving\nwhile Orion is in command.\pWill you take all of us on?$"

	.global MossdeepCity_SpaceCenter_2F_Text_YoureOutnumberedTakeUsOn
HE_English_148::
	.string "ROCKET: Then protect that door!$"

	.global MossdeepCity_SpaceCenter_2F_Text_GoodAnswer
HE_English_149::
	.string "ROCKET: Our orders are to keep this\narea under control!$"

	.global MossdeepCity_SpaceCenter_2F_Text_Grunt5Intro
	.global MossdeepCity_SpaceCenter_2F_Text_Grunt6Intro
	.global MossdeepCity_SpaceCenter_2F_Text_Grunt7Intro
