	.global RustboroCity_Gym_Text_MarcPostBattle
HE_English_440::
	.string "ROXANNE: Birch told me about you. The\nresearcher arrived with the evidence.\pRocket offered Devon security. While\nnegotiating, they installed the\psabotage devices.\pWe're in a war for Hoenn's future.\pI need to know whether you can protect\nyour Pokémon under pressure.\pChallenge my Gym. Let's turn your fear\ninto strength!$"

	.global RustboroCity_Gym_Text_RoxanneIntro
HE_English_441::
	.string "ROXANNE: Even under pressure, you\ntrusted each other.\pThat's what Hoenn needs. Take your\nfirst badge!$"

	.global RustboroCity_Gym_Text_RoxanneDefeat
HE_English_442::
	.string "{PLAYER} received the STONE BADGE!$"

	.global RustboroCity_Gym_Text_ReceivedStoneBadge
HE_English_443::
	.string "ROXANNE: This badge lets you use CUT\noutside battle.\pTake this move for your journey, too.$"

	.global RustboroCity_Gym_Text_StoneBadgeInfoTakeThis
HE_English_444::
	.string "TM39 teaches ROCK TOMB. It deals\ndamage and lowers Speed.\pThe TMs in this adventure are reusable.\nYou can teach the move to several\ppartners!$"

	.global RustboroCity_Gym_Text_ExplainRockTomb
HE_English_445::
	.string "ROXANNE: The first stage is over. Train,\ncatch Pokémon and care for your team.\pWhen the resistance moves out, we'll\nneed you.$"

	.global RustboroCity_Gym_Text_RoxannePostBattle
HE_English_446::
	.string "RUSTBORO GYM\pLeader: ROXANNE$"

	.global RustboroCity_Gym_Text_GymStatue
HE_English_447::
	.string "RUSTBORO GYM\pCertified Trainer: {PLAYER}$"

	.global RustboroCity_Gym_Text_GymStatueCertified
HE_English_448::
	.string "ROXANNE: We need to find Devon's\nresearcher.\pLook in Petalburg Woods, to the south.\pThen return for our challenge!$"

	.global HE_Text_NoProof
HE_English_449::
	.string "The ground starts to shake!\p... radio static ...\pROCKET: Rustboro station, respond.\pThe test is complete. Begin phase two.\pThe target is Hoenn's heart.\pWhen the sky guardian descends, it will\nbe too late.\p... transmission ended ...$"

	.global HE_Text_Radio
HE_English_450::
	.string "ROXANNE: The sky guardian...? What do\nthey want to awaken?\pDevon shut off the device. Rustboro is\nsafe for now. But this was only the\pbeginning.\pI'll gather the Gym Leaders. Birch and\nLaranja protect the south.\pToday you earned more than a badge. You\ngave us a chance to resist.$"

	.global HE_Text_RoxanneResistance
HE_English_451::
	.string "ROXANNE: The researcher built a\ndecoder.\pMeet him in front of the Gym. There is a\ntransmitter in the square.\pCut the signal and find Briney. Dewford\nneeds help.\pThe resistance starts now!$"

	.global HE_Text_EndChapter
HE_English_452::
	.string "Where is Wally? We need to leave for\nVerdanturf.$"

	.global PetalburgCity_Text_WhereIsWally
HE_English_453::
	.string "Did you just arrive?\pNorman is welcoming travelers at the\nGym.\pCome, I'll show you!$"

	.global PetalburgCity_Text_AreYouRookieTrainer
HE_English_454::
	.string "Here is Petalburg's Gym.$"

	.global PetalburgCity_Text_ThisIsPetalburgGym
