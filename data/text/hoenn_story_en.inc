	.global PetalburgCity_Text_AreYouATrainer
HE_English_459::
	.string "SCOTT: You're still starting out, aren't\nyou?\pDon't underestimate danger on the\nroads.$"

	.global PetalburgCity_Text_WellMaybeNot
