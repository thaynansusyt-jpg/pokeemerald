HE_English_152::
	.string "ROCKET: The command center fell, but\nthe fuel is still here.\pWe'll finish off the satellite!$"

	.global MossdeepCity_SpaceCenter_2F_Text_WellTakeCareOfYou
HE_English_153::
	.string "ORION: The satellite will prove our\nsabotage.\pYou don't understand the size of the\ndebt you just took on.$"

	.global MossdeepCity_SpaceCenter_2F_Text_MaxieDontInterfere
HE_English_154::
	.string "STEVEN: There are workers here.\pRemove your charges and hand over the\ncodes.$"

	.global MossdeepCity_SpaceCenter_2F_Text_StevenWhyStealRocketFuel
HE_English_155::
	.string "ORION: Giovanni won't tolerate evidence\nagainst him. If I lose the network,\pnobody gets it back.\pThis fuel will take the Space Center and\nits records with it.$"

	.global MossdeepCity_SpaceCenter_2F_Text_MaxieUseFuelToEruptVolcano
HE_English_156::
	.string "STEVEN: Let's fight together and keep\nthe technicians alive.\pIs your team ready?$"

	.global MossdeepCity_SpaceCenter_2F_Text_StevenAreYouReadyToBattle
HE_English_157::
	.string "STEVEN: Prepare your team. I'll hold this\nposition.$"

	.global MossdeepCity_SpaceCenter_2F_Text_StevenHurryGetReadyQuickly
HE_English_158::
	.string "ORION: Vesper took the core to the sea.\pIf it fails like mine did, there will be\nnowhere to run.$"

	.global MossdeepCity_SpaceCenter_2F_Text_MaxieWeFailedIsAquaAlsoMisguided
HE_English_159::
	.string "ORION: I can't prevent the catastrophe.\pTake the technicians. I'll remove the\ncharges.$"

	.global MossdeepCity_SpaceCenter_2F_Text_MaxieWeWillGiveUp
HE_English_160::
	.string "STEVEN: Everyone got out. The\nemergency broadcast is working again.\pMeet me at my house. I have diving\nequipment. Vesper is beneath the sea.$"

	.global MossdeepCity_SpaceCenter_2F_Text_StevenThankYouComeSeeMeAtHome
HE_English_161::
	.string "ORION: You saved cities and left the\npower source running. Is that what they\pteach at Gyms?\pHoenn will have a new network. Those\nwho obey get water and light. The rest\plearn to beg.\pI don't need to defeat the entire\nLeague. I just need it to arrive too\plate.$"

	.global MtChimney_Text_MaxieIntro
HE_English_162::
	.string "The thermal reserve... is dropping!$"

	.global MtChimney_Text_MaxieDefeat
HE_English_163::
	.string "ORION: The core is already charged.\pShut this machine down if you want. I'll\nregain control in Lavaridge.$"

	.global MtChimney_Text_MaxieYouHaventSeenLastOfMagma
HE_English_164::
	.string "VESPER: Get Orion away from the\namplifier. The power is above its limit.$"

	.global MtChimney_Text_ArchieGoStopTeamMagma
HE_English_165::
	.string "VESPER: My agents are trapped in this\ndispute. Clear a path to the machine.$"

	.global MtChimney_Text_ArchieIHaveMyHandsFull
HE_English_166::
	.string "VESPER: The volcano has stabilized.\pThis isn't an alliance. Today, our\ninterests happened to align.$"

	.global MtChimney_Text_ArchieThankYou
HE_English_167::
	.string "The meteorite keeps the amplifier\nrunning.$"

	.global MtChimney_Text_MeteoriteFittedOnMachine
HE_English_168::
	.string "The amplifier doesn't respond.$"

	.global MtChimney_Text_MachineMakesNoResponse
HE_English_169::
	.string "SOOTOPOLIS\pResistance shelter and recovery\ncenter.$"

	.global SootopolisCity_Text_CitySign
HE_English_170::
	.string "The legendary Pokémon have left the\ncity.\pThe technicians are restoring the\nwater supply.$"

	.global SootopolisCity_Text_WhereDidLegendariesGo
HE_English_171::
	.string "ORION: Stop! There are no commands\nleft! You're destroying the network!$"

	.global SootopolisCity_Text_GroudonPleaseStop
HE_English_172::
	.string "ORION: I mistook power for obedience.\pThe city will pay for what I've done.$"

	.global SootopolisCity_Text_AfterAllOurScheming
HE_English_173::
	.string "VESPER: The core damaged the balance.\pThey don't even know who started this...$"

	.global SootopolisCity_Text_TryingMeaninglessToPokemon
HE_English_174::
	.string "STEVEN: We have shelters in the upper\nhouses, but the water keeps rising.\pWallace studies the ancient sources.\nCome with me.$"

	.global SootopolisCity_Text_InvolvedWithCrisisComeWithMe
HE_English_175::
	.string "STEVEN: Don't fear the Pokémon. They're\nreacting to the wound we opened.\pWe must dismantle the core and call the\none who keeps the two sources in\pbalance.$"

	.global SootopolisCity_Text_DoesThisMakeYourFearPokemon
HE_English_176::
	.string "STEVEN: Wallace is in the cave. He knows\nabout Rayquaza.\pTell him everything about the pulses.$"

	.global SootopolisCity_Text_HereWereAreHelpWallace
HE_English_177::
	.string "STEVEN: With the core gone, the\nlegendary Pokémon are still discharging\penergy.\pRayquaza can separate them.$"

	.global SootopolisCity_Text_KnowWhatsNeededToHelpHim
HE_English_178::
	.string "WALLACE: Rayquaza rests at Sky Pillar,\nbeyond Pacifidlog.\pIt isn't a weapon of the League. We'll\nask for its help to restore the balance.$"

	.global SootopolisCity_Text_NeverBeenToSkyPillar
HE_English_179::
	.string "STEVEN: Rayquaza is bringing the two\nsources back into balance!$"

	.global SootopolisCity_Text_SoThatsRayquaza
HE_English_180::
	.string "STEVEN: The agents retreated. Orion\nremoved the charges. Vesper left the\precords.\pWe still need to erase the copy Giovanni\ntook to the League command center.$"

	.global SootopolisCity_Text_MaxieArchieLeft
HE_English_181::
	.string "WALLACE: Rocket must answer for what\nit did. Saving a city doesn't erase\pextortion at the shelters.\pThe League has received the testimony.\pYour final task is to stop Giovanni\nrestoring the network.$"

	.global SootopolisCity_Text_AquaMagmaDidntMeanHarm
HE_English_182::
	.string "WALLACE: You protected the city.\pTake this technique to reach Ever\nGrande.$"

	.global SootopolisCity_Text_ThankYouForHelpAcceptThis
HE_English_183::
	.string "WALLACE: Waterfall lets you climb\nwaterfalls after your final badge.\pJuan is waiting at the Gym. Your diary\nshows the remaining operation.$"

	.global SootopolisCity_Text_ExplainWaterfallGoToGym
HE_English_184::
	.string "Wattson uses Electric Pokémon. Ground\nis immune to electricity!\pThe floor switches change the barriers.\nStudy the paths before you advance.$"

	.global MauvilleCity_Gym_Text_GymGuideAdvice
HE_English_185::
	.string "Three badges! Mauville's lights are on\nagain.$"

	.global MauvilleCity_Gym_Text_GymGuidePostVictory
HE_English_186::
	.string "We train to protect the shelter. Show\nus your strength!$"

	.global MauvilleCity_Gym_Text_KirkIntro
	.global MauvilleCity_Gym_Text_ShawnIntro
	.global MauvilleCity_Gym_Text_BenIntro
	.global MauvilleCity_Gym_Text_VivianIntro
	.global MauvilleCity_Gym_Text_AngeloIntro
	.global DewfordTown_Gym_Text_TakaoIntro
	.global DewfordTown_Gym_Text_JocelynIntro
	.global DewfordTown_Gym_Text_LauraIntro
	.global DewfordTown_Gym_Text_LilithIntro
	.global DewfordTown_Gym_Text_BrendenIntro
	.global DewfordTown_Gym_Text_CristianIntro
HE_English_187::
	.string "Good battle! You're ready.$"

	.global MauvilleCity_Gym_Text_KirkDefeat
	.global MauvilleCity_Gym_Text_ShawnDefeat
	.global MauvilleCity_Gym_Text_BenDefeat
	.global MauvilleCity_Gym_Text_VivianDefeat
	.global MauvilleCity_Gym_Text_AngeloDefeat
	.global DewfordTown_Gym_Text_TakaoDefeat
	.global DewfordTown_Gym_Text_JocelynDefeat
	.global DewfordTown_Gym_Text_LauraDefeat
	.global DewfordTown_Gym_Text_LilithDefeat
	.global DewfordTown_Gym_Text_BrendenDefeat
	.global DewfordTown_Gym_Text_CristianDefeat
HE_English_188::
	.string "Keep going. Our leader is waiting for\nyou!$"

	.global MauvilleCity_Gym_Text_KirkPostBattle
	.global MauvilleCity_Gym_Text_ShawnPostBattle
	.global MauvilleCity_Gym_Text_BenPostBattle
	.global MauvilleCity_Gym_Text_VivianPostBattle
	.global MauvilleCity_Gym_Text_AngeloPostBattle
	.global DewfordTown_Gym_Text_TakaoPostBattle
	.global DewfordTown_Gym_Text_JocelynPostBattle
	.global DewfordTown_Gym_Text_LauraPostBattle
	.global DewfordTown_Gym_Text_LilithPostBattle
	.global DewfordTown_Gym_Text_BrendenPostBattle
	.global DewfordTown_Gym_Text_CristianPostBattle
HE_English_189::
	.string "WATTSON: The generator is responding\nagain!\pVesper was diverting power out of the\ncity. You cut the command before the\pfinal pulse.\pMy team protects the grid. Let's see if\nyours can weather a storm!$"

	.global MauvilleCity_Gym_Text_WattsonIntro
HE_English_190::
	.string "Hahaha! Your team has energy to spare!\nTake your third badge.$"

	.global MauvilleCity_Gym_Text_WattsonDefeat
HE_English_191::
	.string "{PLAYER} received the DYNAMO BADGE!$"

	.global MauvilleCity_Gym_Text_ReceivedDynamoBadge
HE_English_192::
	.string "This badge lets you use ROCK SMASH\noutside battle.\pYour efforts protected three cities.$"

	.global MauvilleCity_Gym_Text_ExplainDynamoBadgeTakeThis
HE_English_193::
	.string "SHOCK WAVE is an Electric move that\nnever misses.\pThe TM is reusable. Train your team for\nthe next stage.$"

	.global MauvilleCity_Gym_Text_ExplainShockWave
HE_English_194::
	.string "Birch and the Gym Leaders are gathering\nclues.\pRest and take care of your partners.$"

	.global MauvilleCity_Gym_Text_WattsonPostBattle
HE_English_195::
	.string "You gave Hoenn's future a chance!$"

	.global MauvilleCity_Gym_Text_WattsonGoForthAndEndeavor
HE_English_196::
	.string "WATTSON: We must protect the\ngenerator.\pShut down the transmitter in the\nsquare before the challenge.$"

	.global HE_Text_WattsonNeedSignal
HE_English_197::
	.string "... transmission recovered ...\pVESPER: All three nodes fell. Activate\nAsh Protocol.\pUNKNOWN VOICE: The energy has already\nbeen collected. The guardian will hear\pour call.\p... signal lost ...$"

	.global HE_Text_Act3Radio
HE_English_198::
	.string "WATTSON: The cities were batteries...\pWe protected the people, but the stolen\nenergy went to the volcano.\pBirch and the Gym Leaders will meet. We\nmust find out what they intend to\pawaken.\pToday, Hoenn lit up again. Thanks to\nyou.$"

	.global HE_Text_Act3Wattson
HE_English_199::
	.string "CHAPTER 4: ASHES\pRocket moved its energy to the volcano.\pFollow Routes 111 and 112. Lavaridge\nneeds help.$"

	.global HE_Text_Act3End
HE_English_200::
	.string "You're {PLAYER}, our new neighbor!\p{RIVAL} is upstairs, preparing\nresearch with Birch.$"

	.global RivalsHouse_1F_Text_OhYoureTheNewNeighbor
HE_English_201::
	.string "{RIVAL} is worried about the\nregion's Pokémon.$"

	.global RivalsHouse_1F_Text_TooBusyToNoticeVisit
HE_English_202::
	.string "MAY: You're {PLAYER}! I'm May, Birch's\ndaughter.\pI want to meet Pokémon from all over\nthe world! But they're fleeing the\pforests.\pI'll help my dad find out why. See you\nlater!$"

	.global RivalsHouse_1F_Text_MayWhoAreYou
	.global RivalsHouse_2F_Text_MayWhoAreYou
HE_English_203::
	.string "BRENDAN: You're {PLAYER}! I'm Brendan,\nBirch's son.\pMy dad studies the tremors. Pokémon\nsense danger before we do.\pI'll help collect the data. See you\nlater!$"

	.global RivalsHouse_1F_Text_BrendanWhoAreYou
	.global RivalsHouse_2F_Text_BrendanWhoAreYou
HE_English_204::
	.string "Hey, neighbor! Do you have a Pokémon\nyet?$"

	.global RivalsHouse_1F_Text_DoYouHavePokemon
HE_English_205::
	.string "ROCKET: These shipments support our\noperation.\pYou aren't taking them!$"

	.global AquaHideout_B1F_Text_Grunt2Intro
	.global AquaHideout_B1F_Text_Grunt3Intro
	.global AquaHideout_B1F_Text_Grunt5Intro
	.global AquaHideout_B1F_Text_Grunt7Intro
	.global AquaHideout_B2F_Text_Grunt4Intro
	.global AquaHideout_B2F_Text_Grunt6Intro
	.global AquaHideout_B2F_Text_Grunt8Intro
HE_English_206::
	.string "I couldn't protect the cargo!$"

	.global AquaHideout_B1F_Text_Grunt2Defeat
	.global AquaHideout_B1F_Text_Grunt3Defeat
	.global AquaHideout_B1F_Text_Grunt5Defeat
	.global AquaHideout_B1F_Text_Grunt7Defeat
	.global AquaHideout_B2F_Text_Grunt4Defeat
	.global AquaHideout_B2F_Text_Grunt6Defeat
	.global AquaHideout_B2F_Text_Grunt8Defeat
HE_English_207::
	.string "The submarine is carrying the core.\pThe exit is on the lower floor.$"

	.global AquaHideout_B1F_Text_Grunt2PostBattle
	.global AquaHideout_B1F_Text_Grunt3PostBattle
	.global AquaHideout_B1F_Text_Grunt5PostBattle
	.global AquaHideout_B1F_Text_Grunt7PostBattle
	.global AquaHideout_B2F_Text_Grunt4PostBattle
	.global AquaHideout_B2F_Text_Grunt6PostBattle
	.global AquaHideout_B2F_Text_Grunt8PostBattle
HE_English_208::
	.string "You don't have to prove everything at\nonce, Wally.$"

	.global MauvilleCity_Text_UncleYourePushingIt
HE_English_209::
	.string "WALLY: {PLAYER}, will you train with\nme?$"

	.global MauvilleCity_Text_WallyWillYouBattleMe
HE_English_210::
	.string "I need to show I can protect my\npartner.$"

	.global MauvilleCity_Text_WallyMyUncleWontKnowImStrong
HE_English_211::
	.string "WALLY: Let's do our best!$"

	.global MauvilleCity_Text_WallyHereICome
HE_English_212::
	.string "We still have so much to learn...$"

	.global MauvilleCity_Text_WallyDefeat
HE_English_213::
	.string "WALLY: I'll rest with my uncle.\pI promise to keep training!$"

	.global MauvilleCity_Text_WallyIllGoBackToVerdanturf
HE_English_214::
	.string "Thank you for helping Wally.\pHe needs to rest before continuing.$"

	.global MauvilleCity_Text_ThankYouNotEnoughToBattle
HE_English_215::
	.string "You've grown so much. A defeat can\nteach you, too.$"

	.global MauvilleCity_Text_UncleNoNeedToBeDown
HE_English_216::
	.string "WALLY: I want to keep learning with you!$"

	.global MauvilleCity_Text_WallyPokenavCall
HE_English_217::
	.string "SCOTT: You help every city you pass\nthrough.\pThe resistance needs that courage!$"

	.global MauvilleCity_Text_ScottYouDidntHoldBack
HE_English_218::
	.string "The lights flicker. The ground vibrates\nbeneath your feet.\pVOLUNTEER: The commander installed a\ntransmitter in the square, near the\pvolunteer.\pUse Stern's key. The city can't survive\nanother pulse!$"

	.global HE_Text_MauvilleArrival
HE_English_219::
	.string "WALLACE: You cut through a network of\nfear and returned the region to its\ppeople.\pThis title doesn't demand that you save\neverything alone. It demands that you\precognize the strength of those\nfighting beside you.\pWelcome to the Pokémon League's final\nbattle!$"

	.global EverGrandeCity_ChampionsRoom_Text_IntroSpeech
HE_English_220::
	.string "Your partners crossed the crisis with\nyou.\pThis victory belongs to all of you.$"

	.global EverGrandeCity_ChampionsRoom_Text_Defeat
HE_English_221::
	.string "WALLACE: Hoenn has a new Champion!\pReconstruction continues. This title\ncan open doors for those who weren't\pheard before.$"

	.global EverGrandeCity_ChampionsRoom_Text_PostBattleSpeech
HE_English_222::
	.string "Rayquaza awakened!\pThe guardian flies toward Sootopolis.$"

	.global SkyPillar_Top_Text_RayquazaFlewOff
HE_English_223::
	.string "Save your progress through the menu.\pA safe journey begins with preparation!$"

	.global OldaleTown_Text_SavingMyProgress
HE_English_224::
	.string "I work at the Poké Mart.\pWe're distributing medicine to\ntravelers.$"

	.global OldaleTown_Text_IWorkAtPokemonMart
HE_English_225::
	.string "This is the Poké Mart. You can buy\nmedicine and Poké Balls here.\pTake a sample for your journey!$"

	.global OldaleTown_Text_ThisIsAPokemonMart
HE_English_226::
	.string "Wait! This road is closed!\pThe tremors opened cracks. Come back\nafter speaking with Birch.$"

	.global OldaleTown_Text_WaitDontComeInHere
HE_English_227::
	.string "The road has reopened. Travel\ncarefully!$"

	.global OldaleTown_Text_FinishedSketchingFootprints
HE_English_228::
	.string "MAY: Let's head back to the lab!$"

	.global OldaleTown_Text_MayLetsGoBack
HE_English_229::
	.string "BRENDAN: Let's head back to the lab!$"

	.global OldaleTown_Text_BrendanLetsGoBack
HE_English_230::
	.string "Join Hoenn's research project!\pRecord ten different species and\nreturn for an EXP. SHARE.\pRecorded: {STR_VAR_1}.\pEvolutions count, too!$"

	.global HoennExpansion_Text_Research
HE_English_231::
	.string "Excellent research! You've recorded\nten species in Hoenn.\pHere's your reward!$"

	.global HoennExpansion_Text_ResearchReward
HE_English_232::
	.string "Your Bag is full. Organize your items\nand come back for the reward.$"

	.global HoennExpansion_Text_BagFull
HE_English_233::
	.string "Give EXP. SHARE to a Pokémon to help it\ntrain with your team.\pKeep exploring. New encounters await\nyou in Hoenn!$"

	.global HoennExpansion_Text_ResearchComplete
HE_English_234::
	.string "Birch wants to find out why the Pokémon\nare fleeing.$"

	.global LittlerootTown_ProfessorBirchsLab_Text_BirchIsntOneForDeskWork
HE_English_235::
	.string "Birch's research may help protect\nHoenn.$"

	.global LittlerootTown_ProfessorBirchsLab_Text_BirchEnjoysRivalsHelpToo
HE_English_236::
	.string "BIRCH: The device emitted a signal that\nfrightened the Pokémon.\pSomeone is causing this crisis. Your\nfather suspects Team Rocket.\pYou acted bravely. I want you to keep\nyour partner.\p{PLAYER} received {STR_VAR_1}!$"

	.global LittlerootTown_ProfessorBirchsLab_Text_LikeYouToHavePokemon
HE_English_237::
	.string "BIRCH: {RIVAL} is on Route 103\ncollecting data.\pA practice battle will prepare you both\nfor the road.\pWill you go meet {RIVAL}?$"

	.global LittlerootTown_ProfessorBirchsLab_Text_MightBeGoodIdeaToGoSeeRival
HE_English_238::
	.string "Head north of Oldale, to Route 103.\pThen both of you should return to the\nlab!$"

	.global LittlerootTown_ProfessorBirchsLab_Text_GetRivalToTeachYou
HE_English_239::
	.string "BIRCH: You're back!\pThe signals on Route 103 match those\non Route 101. It wasn't an accident.\pTake this Pokédex to record the\naffected Pokémon.$"

	.global LittlerootTown_ProfessorBirchsLab_Text_HeardYouBeatRivalTakePokedex
HE_English_240::
	.string "BIRCH: The Pokédex records the Pokémon\nyou encounter and catch.\pCompare their habitats. If Pokémon\nabandon an area, another device may be\pnearby.\pNorman is coordinating Petalburg's\nshelter. Go speak with him.$"

	.global LittlerootTown_ProfessorBirchsLab_Text_ExplainPokedex
HE_English_241::
	.string "BIRCH: Continue to Petalburg.\pSenhor Laranja will protect Littleroot.\nWe aren't alone!$"

	.global LittlerootTown_ProfessorBirchsLab_Text_CountlessPokemonAwait
HE_English_242::
	.string "MAY: We're a team now! Take these Poké\nBalls.$"

	.global LittlerootTown_ProfessorBirchsLab_Text_MayGotPokedexTooTakeThese
HE_English_243::
	.string "MAY: Catch new partners. I'll monitor\nthe signals here.\pSee you safe and sound!$"

	.global LittlerootTown_ProfessorBirchsLab_Text_CatchCutePokemonWithPokeBalls
HE_English_244::
	.string "Your Bag is full!$"

	.global LittlerootTown_ProfessorBirchsLab_Text_OhYourBagsFull
	.global LittlerootTown_ProfessorBirchsLab_Text_HeyYourBagsFull
HE_English_245::
	.string "BRENDAN: We're a team now! Take these\nPoké Balls.$"

	.global LittlerootTown_ProfessorBirchsLab_Text_BrendanGotPokedexTooTakeThese
HE_English_246::
	.string "BRENDAN: Catch new partners. I'll\nmonitor the signals here.\pSee you safe and sound!$"

	.global LittlerootTown_ProfessorBirchsLab_Text_CatchCoolPokemonWithPokeBalls
HE_English_247::
	.string "ROCKET: Vesper isn't here. Our\ntransport still needs a vessel.\pGet out!$"

	.global AquaHideout_1F_Text_OurBossIsSnatchingSomething
HE_English_248::
	.string "ROCKET: Orion is working at the volcano.\pI won't give you the other base's\nlocation!$"

	.global AquaHideout_1F_Text_WhereMightMagmaHideoutBe
HE_English_249::
	.string "ROCKET: Vesper went to get the\nsubmarine in Slateport.\pThe coast belongs to our operation!$"

	.global AquaHideout_1F_Text_BossWentToJackASubmarine
HE_English_250::
	.string "ROCKET: Vesper followed Route 122 to\nMt. Pyre.\pThe core is our objective.$"

	.global AquaHideout_1F_Text_BossIsOnRoute122
HE_English_251::
	.string "ROCKET: Orion already has a source at\nMt. Chimney.\pVesper won't depend on him.$"

	.global AquaHideout_1F_Text_TeamMagmaAtMtChimney
HE_English_252::
	.string "ROCKET: Vesper went to Slateport.\pWe have no orders to let you in.$"

	.global AquaHideout_1F_Text_BossIsInSlateportCity
HE_English_253::
	.string "DAD: {PLAYER}! You're all right!\pBirch told me. Rocket is seizing power\nplants and using blackouts to steal\pPokémon.\pThe League protects the shelters, but\ncan't watch every road.\pStay close to your partners.$"

	.global PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon
HE_English_254::
	.string "DAD: You're Wally, right?$"

	.global PetalburgCity_Gym_Text_DadOhYoureWallyRight
HE_English_255::
	.string "WALLY: I'll stay with relatives in\nVerdanturf.\pI'm scared of the road. I've never\ncaught a Pokémon...$"

	.global PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon
HE_English_256::
	.string "DAD: I understand. We'll help.$"

	.global PetalburgCity_Gym_Text_DadHmISee
HE_English_257::
	.string "I'll lend you my Zigzagoon.\pWALLY received ZIGZAGOON!$"

	.global PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon
HE_English_258::
	.string "WALLY: Thank you!\pDAD: Take this Poké Ball, too.\pWALLY received a POKé BALL!$"

	.global PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall
HE_English_259::
	.string "WALLY: Yes! Here's your Pokémon back.\pThank you, {PLAYER}. Now I have the\ncourage to travel.\pI'll take good care of my partner. See\nyou!$"

	.global PetalburgCity_Gym_Text_WallyThankYouBye
HE_English_260::
	.string "DAD: I received an alert from Rustboro.\nDevon lost contact with a researcher in\pthe woods.\pFollow Route 104. If you find anyone in\ndanger, help them.\pThen find Roxanne. She's preparing the\ncity's defenses.\pA badge proves you can protect your\nteam. Train before facing Rocket!$"

	.global PetalburgCity_Gym_Text_DadGoCollectBadges
HE_English_261::
	.string "DAD: Find Roxanne in Rustboro.\pThe road goes through Petalburg Woods.$"

	.global PetalburgCity_Gym_Text_NormanGoToRustboro
HE_English_262::
	.string "DAD: Roxanne told me about your\nvictory.\pYou gave Hoenn hope! Rest. We'll need\nyou for the next stage.$"

	.global PetalburgCity_Gym_Text_NormanGoToDewford
HE_English_263::
	.string "STERN: Rocket seized the harbor. They\nwant to turn our boats into mobile\pantennas.\pI captured the key to Mauville's\nnetwork.\pWe must take it to Wattson.$"

	.global HE_Text_SternMission
HE_English_264::
	.string "VESPER: Commander of Operation Eclipse.\pThe League calls this a collapse. I call\nit a region learning to obey.\pThe leaders will surrender Hoenn when\nthey can't light a single lamp.$"

	.global HE_Text_HarborVesper
HE_English_265::
	.string "You interrupted the transmission!$"

	.global HE_Text_HarborLose
HE_English_266::
	.string "VESPER: You protected one harbor. The\nentire power grid is another matter.\pSee you in Mauville. The sky is already\nchanging.$"

	.global HE_Text_HarborExit
HE_English_267::
	.string "STERN: The boats are free!\pI stored the key in your decoder. It\nopens Mauville's terminal.\pHead north along Route 110. You gave\nthis city its horizon back.$"

	.global HE_Text_SternSaved
HE_English_268::
	.string "ORION: The network was split. I need a\nsource no city can shut down.\pGroudon, receive the core's energy!\nHoenn will depend on us!$"

	.global MagmaHideout_4F_Text_MaxieAwakenGroudon
HE_English_269::
	.string "ORION: No! The core was supposed to\nlimit the discharge! Why won't it obey?$"

	.global MagmaHideout_4F_Text_MaxieGroudonWhatsWrong
HE_English_270::
	.string "ORION: You removed the meteorite.\pI must recover the amplifier before\nVesper uses the other core.\pI won't let a child end my operation!$"

	.global MagmaHideout_4F_Text_MaxieOhItWasYou
HE_English_271::
	.string "The system is beyond my reach...$"

	.global MagmaHideout_4F_Text_MaxieDefeat
HE_English_272::
	.string "ORION: If the energy can't be\ncontained, we'll destroy the center\pthat distributes the codes.\pThe satellite must fall!$"

	.global MagmaHideout_4F_Text_MaxieImGoingAfterGroudon
HE_English_273::
	.string "Mom: We're here, {PLAYER}!\pLittleroot seemed the perfect place to\nstart again.\pYour dad is worried about Hoenn's\ntremors. Here, we'll be together.\pLet's see our house!$"

	.global LittlerootTown_Text_OurNewHomeLetsGoInside
HE_English_274::
	.string "Mom: Wait, {PLAYER}!$"

	.global LittlerootTown_Text_WaitPlayer
HE_English_275::
	.string "Mom: Birch gave you a Pokémon! It's good\nto see you together.\pTake these shoes. The roads have been\ndifficult since the blackouts.$"

	.global LittlerootTown_Text_WearTheseRunningShoes
HE_English_276::
	.string "{PLAYER} put on the Running Shoes!$"

	.global LittlerootTown_Text_SwitchShoesWithRunningShoes
HE_English_277::
	.string "Mom: Hold B to run. But rest when you\nneed to!$"

	.global LittlerootTown_Text_ExplainRunningShoes
HE_English_278::
	.string "Mom: Promise you'll come back.\pIf the world out there gets\nfrightening, our home will be here.\pTake care of each other!$"

	.global LittlerootTown_Text_ComeHomeIfAnythingHappens
HE_English_279::
	.string "The Pokémon in the grass have been\nrestless since the tremor.$"

	.global LittlerootTown_Text_IfYouGoInGrassPokemonWillJumpOut
HE_English_280::
	.string "It's dangerous to go alone without a\nPokémon!$"

	.global LittlerootTown_Text_DangerousIfYouDontHavePokemon
HE_English_281::
	.string "I heard a crash on Route 101! The\nPokémon are frightened.\pThe professor went to investigate and\nis calling for help!$"

	.global LittlerootTown_Text_CanYouGoSeeWhatsHappening
HE_English_282::
	.string "You saved the professor! Thank\ngoodness!$"

	.global LittlerootTown_Text_YouSavedBirch
HE_English_283::
	.string "Hello, are you new around here?\pI'm SENHOR LARANJA! I can't wait for our\nbattle.\pCome back after getting the Pokédex.\nI'll help you on your journey. Here!$"

	.global HoennExpansion_Text_LaranjaWelcome
HE_English_284::
	.string "Six Rare Candies!\pIf Rocket shows up, count on me and my\nPikachu.$"

	.global HoennExpansion_Text_LaranjaGift
HE_English_285::
	.string "Make some room in your Bag. I'll keep\nyour gift safe!$"

	.global HoennExpansion_Text_LaranjaBagFull
HE_English_286::
	.string "You got the Pokédex! Shall we train to\ndefend Hoenn?$"

	.global HoennExpansion_Text_LaranjaChallenge
HE_English_287::
	.string "LARANJA: Let's go, Pikachu!$"

	.global HoennExpansion_Text_LaranjaBattle
HE_English_288::
	.string "Well done! Hoenn will need people like\nyou.$"

	.global HoennExpansion_Text_LaranjaDefeated
HE_English_289::
	.string "Come back with the Pokédex.\pI'm organizing aid for the cities.$"

	.global HoennExpansion_Text_LaranjaWait
HE_English_290::
	.string "Birch trusts you.\pGo see Roxanne in Rustboro. I'll protect\nLittleroot!$"

	.global HoennExpansion_Text_LaranjaAfterBattle
HE_English_291::
	.string "WALLACE: You stopped the antennas, but\nthe ancient sources still draw each\pother in.\pThe cores were made to limit that\nenergy. Rocket used them to produce\pmore.\pRayquaza can separate Groudon and\nKyogre. I need to find out where it\prests.$"

	.global CaveOfOrigin_B1F_Text_WallaceStory
HE_English_292::
	.string "WALLACE: Have you heard where Rayquaza\nis?\pThink of the guardians' stories.$"

	.global CaveOfOrigin_B1F_Text_WhereIsRayquaza
HE_English_293::
	.string "WALLACE: This cave shelters the two\nconflicting sources.\pRayquaza needs a place in the sky.$"

	.global CaveOfOrigin_B1F_Text_ButWereInCaveOfOrigin
HE_English_294::
	.string "WALLACE: The guardians at Mt. Pyre keep\nthe cores.\pRayquaza rests far from them.$"

	.global CaveOfOrigin_B1F_Text_OldLadyDidntMentionThat
HE_English_295::
	.string "WALLACE: We must remember. The sky's\nguardian has a sanctuary beyond the\pcoast.$"

	.global CaveOfOrigin_B1F_Text_CantYouRememberSomehow
HE_English_296::
	.string "WALLACE: Sky Pillar! That's it.\pI'll open the way. Meet me there. The\ncity can't wait.$"

	.global CaveOfOrigin_B1F_Text_WellHeadToSkyPillar
HE_English_297::
	.string "VESPER: Don't touch the core!$"

	.global SeafloorCavern_Room9_Text_ArchieHoldItRightThere
HE_English_298::
	.string "VESPER: The orbital command center is\ndown.\pYou've come farther than Giovanni\nimagined.$"

	.global SeafloorCavern_Room9_Text_ArchieSoItWasYou
HE_English_299::
	.string "VESPER: This core awakens the ocean\nsource. If I stabilize the sea, the\pcities will need me.\pOrion failed because he wanted\nlimitless energy. I have the Institute's\pdata.$"

	.global SeafloorCavern_Room9_Text_ArchieBeholdKyogre
HE_English_300::
	.string "VESPER: I'm close to fixing everything.\pI won't abandon the operation now!$"

	.global SeafloorCavern_Room9_Text_ArchieYouMustDisappear
HE_English_301::
	.string "I can't lose the only control I have\nleft!$"

	.global SeafloorCavern_Room9_Text_ArchieDefeat
HE_English_302::
	.string "VESPER: The core still works. Kyogre,\nreceive the pulse!$"

	.global SeafloorCavern_Room9_Text_ArchieWithThisRedOrb
HE_English_303::
	.string "The core shines on its own. The\ndischarge breaks through the limit!$"

	.global SeafloorCavern_Room9_Text_RedOrbShinesByItself
HE_English_304::
	.string "VESPER: The signal vanished? Why did it\nleave the control area?$"

	.global SeafloorCavern_Room9_Text_ArchieWhereDidKyogreGo
HE_English_305::
	.string "RADIO: Sirens are sounding on every\nisland!$"

	.global SeafloorCavern_Room9_Text_ArchieAMessageFromOutside
HE_English_306::
	.string "VESPER: Endless rain? That wasn't in\nthe data! Shut down the antennas!$"

	.global SeafloorCavern_Room9_Text_ArchieWhatRainingTooHard
HE_English_307::
	.string "VESPER: The sea doesn't obey the core.\nWe only wounded it...$"

	.global SeafloorCavern_Room9_Text_ArchieWhyDidKyogreDisappear
HE_English_308::
	.string "ORION: I lost the thermal source, too.\pThe two discharges are drawing each\nother in.$"

	.global SeafloorCavern_Room9_Text_MaxieWhatHaveYouWrought
HE_English_309::
	.string "VESPER: You increased the charge\nwithout telling me.\pGiovanni demanded results from both of\nus!$"

	.global SeafloorCavern_Room9_Text_ArchieDontGetAllHighAndMighty
HE_English_310::
	.string "ORION: There's no time for blame.\pSootopolis is at the center of the\ndisturbance.$"

	.global SeafloorCavern_Room9_Text_MaxieWeDontHaveTimeToArgue
HE_English_311::
	.string "ORION: Go to the surface. The League\nneeds to know.\pGiovanni has already received a copy of\nthe codes.$"

	.global SeafloorCavern_Room9_Text_MaxieComeOnPlayer
HE_English_312::
	.string "ROCKET AGENT: The forecasts feed our\nantennas.\pThe Institute won't return its data to\nthe League!$"

	.global Route119_WeatherInstitute_2F_Text_ShellyIntro
HE_English_313::
	.string "The operation's record was exposed!$"

	.global Route119_WeatherInstitute_2F_Text_ShellyDefeat
HE_English_314::
	.string "ROCKET AGENT: Vesper has copies.\pYou may save this Institute, but not\nthe islands.$"

	.global Route119_WeatherInstitute_2F_Text_ShellyPostBattle
HE_English_315::
	.string "ROCKET: Orion reached the sanctuary.\pThe other core is on the move.$"

	.global Route119_WeatherInstitute_2F_Text_TeamMagmaJustPassedBy
HE_English_316::
	.string "ROCKET: Retreat! Vesper is waiting at\nMt. Pyre!$"

	.global Route119_WeatherInstitute_2F_Text_WeHaveToHurryToMtPyre
HE_English_317::
	.string "RESEARCHER: We recovered the\nrecordings. They were causing storms to\psell protection.\pThis Castform helped detect the\npulses. Take it.\pThe data must reach Winona.$"

	.global Route119_WeatherInstitute_2F_Text_ThanksPleaseTakePokemon
HE_English_318::
	.string "Your team is full. Make room for\nCastform.$"

	.global Route119_WeatherInstitute_2F_Text_NoRoomForPokemon
HE_English_319::
	.string "Castform senses changes in the\nweather.\pRocket's pulses disturb its body.$"

	.global Route119_WeatherInstitute_2F_Text_PokemonChangesWithWeather
HE_English_320::
	.string "They tried to treat the weather like a\nmachine.\pThey didn't understand the beings that\nmaintain its balance.$"

	.global Route119_WeatherInstitute_2F_Text_ChangingWeatherRidiculous
HE_English_321::
	.string "The tunnels ahead are dark. Bring\nFLASH!\pThe transmitter is here at the\nentrance, to the west.\pYou don't need to descend to shut it\ndown.$"

	.global GraniteCave_1F_Text_GetsDarkAheadHereYouGo
HE_English_322::
	.string "FLASH lights the cave after Brawly's\nbadge.\pTake care of the transmitter first.$"

	.global GraniteCave_1F_Text_ExplainFlash
HE_English_323::
	.string "BRINEY: Roxanne asked for our help.\pDewford lost contact with the mainland.\nWant to sail to the island?$"

	.global Route104_MrBrineysHouse_Text_ItsYouLetsSailToDewford
HE_English_324::
	.string "BRINEY: Anchors aweigh! Dewford needs\nus.$"

	.global Route104_MrBrineysHouse_Text_SetSailForDewford
HE_English_325::
	.string "BRINEY: Prepare your team. I'll wait for\nyou.$"

	.global Route104_MrBrineysHouse_Text_DeclineDeliverySail
HE_English_326::
	.string "BRINEY: Shall we help Dewford?$"

	.global Route104_MrBrineysHouse_Text_NeedToMakeDeliveriesSailToDewford
	.global Route104_MrBrineysHouse_Text_NeedToDeliverPackageSailToDewford
HE_English_327::
	.string "BRINEY: I'll be here when you need me.$"

	.global Route104_MrBrineysHouse_Text_TellMeWheneverYouWantToSail
	.global Route109_Text_BrineyTellMeWhenYouNeedToSail
	.global DewfordTown_Text_JustTellMeWhenYouNeedToSetSail
HE_English_328::
	.string "BRINEY: The signal confuses Peeko. I\ncan't sail.\pShut down the transmitter near\nRustboro's Gym.$"

	.global HE_Text_BrineyClosed
HE_English_329::
	.string "ROCKET: Vesper needs to leave with the\ncore.\pYou aren't getting through!$"

	.global MtPyre_Summit_Text_Grunt1Intro
	.global MtPyre_Summit_Text_Grunt2Intro
	.global MtPyre_Summit_Text_Grunt3Intro
	.global MtPyre_Summit_Text_Grunt4Intro
HE_English_330::
	.string "We lost our position!$"

	.global MtPyre_Summit_Text_Grunt1Defeat
	.global MtPyre_Summit_Text_Grunt2Defeat
	.global MtPyre_Summit_Text_Grunt3Defeat
	.global MtPyre_Summit_Text_Grunt4Defeat
HE_English_331::
	.string "The core has already been taken.\pTransport is waiting at the harbor.$"

	.global MtPyre_Summit_Text_Grunt1PostBattle
	.global MtPyre_Summit_Text_Grunt2PostBattle
	.global MtPyre_Summit_Text_Grunt3PostBattle
	.global MtPyre_Summit_Text_Grunt4PostBattle
HE_English_332::
	.string "VESPER: Orion took the thermal core. We\ntook the ocean core.\pThey were kept together for a reason.\nBut Giovanni only wants results.\pRetreat! Transport is waiting in\nSlateport.$"

	.global MtPyre_Summit_Text_ArchieWeGotTheOrbLetsGo
HE_English_333::
	.string "The invaders separated the two cores.\nIf they activate them, the ancient\psources will fight again.\pOrion dropped this emblem as he fled. It\nopens the volcano base.\pTake it and recover the cores.$"

	.global MtPyre_Summit_Text_BothOrbsTakenMagmaLeftThis
HE_English_334::
	.string "The blue and red cores were stolen.\pApart, they cannot limit the discharge.$"

	.global MtPyre_Summit_Text_OrbsHaveBeenTaken
HE_English_335::
	.string "Groudon and Kyogre awakened? Then\nRocket broke the safeguards.\pThe cores preserved the balance. Only\nRayquaza can contain both sources now.$"

	.global MtPyre_Summit_Text_GroudonKyogreAwakened
HE_English_336::
	.string "Both commanders returned the cores.\nThat doesn't erase what they did.\pThe guardians will record their actions\nand turn them over to the League.$"

	.global MtPyre_Summit_Text_ThoseTwoMenReturnedOrbs
HE_English_337::
	.string "Land, sea and sky live in balance. They\ndon't exist to obey orders.\pHoenn is alive. We must listen to it.$"

	.global MtPyre_Summit_Text_SuperAncientPokemonTaughtUs
HE_English_338::
	.string "Mt. Pyre preserves the memory of\nPokémon who have passed on.\pWould you like to hear the story of the\nancient sources?$"

	.global MtPyre_Summit_Text_WillYouHearOutMyTale
HE_English_339::
	.string "Long ago, Groudon and Kyogre fought\nover the world. The land burned. The sea\pcovered villages.\pTwo cores limited their energy and\nended the conflict.\pSeparated, they are not safe weapons.\nThat is the warning Orion ignored.$"

	.global MtPyre_Summit_Text_GroudonKyogreTale
HE_English_340::
	.string "I understand. Come back whenever you\nwant to listen.$"

	.global MtPyre_Summit_Text_WellThatTooIsFine
HE_English_341::
	.string "ORION: {PLAYER}...\pI returned the core. I don't expect\nthat to buy your forgiveness.$"

	.global MtPyre_Summit_Text_MaxieSilence
HE_English_342::
	.string "History must remember what happened in\nSootopolis.\pWould you like to hear how Hoenn\nresisted?$"

	.global MtPyre_Summit_Text_HearTheNewLegendOfHoenn
HE_English_343::
	.string "When the ancient sources lost their\nlimits, Rayquaza came from the sky.\pIt separated Groudon and Kyogre.\nPeople opened their shelters and cared\pfor the wounded.\pThe region survived because nobody had\nto fight alone.$"

	.global MtPyre_Summit_Text_HoennTrioTale
HE_English_344::
	.string "I saw someone with an R on their uniform\nnear Devon.\pThey didn't look like an employee...$"

	.global RustboroCity_Text_SneakyLookingManWentAroundCorner
HE_English_345::
	.string "Roxanne is organizing aid at the Gym. Go\nfind her!$"

	.global RustboroCity_Text_HaveYouChallengedGym
HE_English_346::
	.string "Your first badge! Now we have another\nally!$"

	.global RustboroCity_Text_HeyThatsRustborosGymBadge
HE_English_347::
	.string "Fire Pokémon struggle against Rock.\pI need more variety in my team.$"

	.global RustboroCity_Text_GymLeaderIsntEasyWithFire
HE_English_348::
	.string "DEVON CORPORATION\pEnergy and technology for Hoenn.$"

	.global RustboroCity_Text_DevonCorpSign
HE_English_349::
	.string "RUSTBORO GYM\pLeader: ROXANNE\pLeague support station.$"

	.global RustboroCity_Text_GymSign
HE_English_350::
	.string "RUSTBORO\pEmergency shelter open at the Gym.$"

	.global RustboroCity_Text_CitySign
HE_English_351::
	.string "TRAINER SCHOOL\pLearn to care for your team.$"

	.global RustboroCity_Text_TrainersSchoolSign
HE_English_352::
	.string "ORION: The meteorite amplifies the\nthermal core.\pWith it, the shelters will need Rocket\nfor water.$"

	.global MeteorFalls_1F_1R_Text_WithThisMeteorite
HE_English_353::
	.string "ROCKET: The scientist works for us now.\pStay back!$"

	.global MeteorFalls_1F_1R_Text_DontExpectMercyFromMagma
HE_English_354::
	.string "VESPER: Orion! The deal was to control\nthe grid, not destroy reservoirs!$"

	.global MeteorFalls_1F_1R_Text_HoldItRightThereMagma
HE_English_355::
	.string "ORION: Giovanni's orders. If you have\ndoubts, discuss them with him.\pWe're heading to the volcano.$"

	.global MeteorFalls_1F_1R_Text_BeSeeingYouTeamAqua
HE_English_356::
	.string "VESPER: You're the one cutting the\nsignals.\pThen you've seen what these pulses do.$"

	.global MeteorFalls_1F_1R_Text_ArchieSeenYouBefore
HE_English_357::
	.string "ROCKET: Orion is taking the meteorite\nto Mt. Chimney!$"

	.global MeteorFalls_1F_1R_Text_BossWeShouldChaseMagma
HE_English_358::
	.string "VESPER: Let's go. If he loses control,\nthe coast will fall, too.$"

	.global MeteorFalls_1F_1R_Text_ArchieYesNoTellingWhatMagmaWillDo
HE_English_359::
	.string "VESPER: Don't mistake our dispute for\nhelp.\pI still want Hoenn's network.$"

	.global MeteorFalls_1F_1R_Text_ArchieFarewell
HE_English_360::
