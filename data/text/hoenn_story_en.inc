	.global LilycoveCity_Text_ChanceToDoBigThings
HE_English_409::
	.string "ROCKET: Vesper says the network will\nend the crisis.\pWhy are the families running from us?$"

	.global LilycoveCity_Text_IfWorldBecomesOurs
