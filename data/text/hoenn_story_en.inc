	.global Route119_WeatherInstitute_2F_Text_Grunt3Defeat
	.global Route119_WeatherInstitute_2F_Text_Grunt5Defeat
HE_English_151::
	.string "I was following orders. That won't erase\nwhat happened here.$"

	.global MossdeepCity_SpaceCenter_2F_Text_Grunt6PostBattle
	.global MossdeepCity_SpaceCenter_2F_Text_Grunt7PostBattle
	.global MossdeepCity_SpaceCenter_2F_Text_Grunt5PostBattle
